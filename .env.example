# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.

# --- Extracteur LLM : uv run --group llm --env-file .env ... (ADR 0002) ---

# Clé de l'API Gemini, créée dans AI Studio sur un projet sans facturation liée.
GEMINI_API_KEY=

# Facultatif : plafonds plus stricts que ceux du code (bond_terms.llm.LIMITS), jamais plus larges.
# Requêtes par jour et par modèle ; secondes entre deux requêtes.
BOND_TERMS_LLM_MAX_JOUR=
BOND_TERMS_LLM_INTERVALLE_S=

# --- Bac à sable BigQuery : uv run --group bigquery --env-file .env ... ---

# Identifiant du projet Google Cloud du bac à sable (aucune facturation liée).
BOND_TERMS_GCP_PROJECT=

# Chemin vers la clé JSON du compte de service, rangée hors du dépôt.
GOOGLE_APPLICATION_CREDENTIALS=
